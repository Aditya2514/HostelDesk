# Database (Neon PostgreSQL)
# Pooled URL for application queries (pgBouncer / Neon connection pooler)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/hosteldesk?sslmode=require&pgbouncer=true"
# Direct non-pooled URL for Prisma migrations
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/hosteldesk?sslmode=require"

# Authentication
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"

# Client URL (CORS)
CLIENT_ORIGIN="http://localhost:5173"

# Cloudinary (File storage)
CLOUDINARY_CLOUD_NAME="demo-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz12345"

# Cron / Keep-awake Jobs Secret (x-jobs-secret header)
JOBS_SECRET="secret-jobs-token-replace-in-production"

# Demo Mode (enables time-travel endpoint and demo accounts panel)
DEMO_MODE="true"

# Server Port
PORT="4000"
