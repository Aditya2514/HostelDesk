# Base URL for the Express backend API
# In dev: "http://localhost:4000" or empty string "" (using Vite proxy)
# In production on Vercel: leave empty "" so requests use the same-site /api rewrite to prevent Safari/iOS cookie blocking
VITE_API_URL=""

# Enable demo mode features (e.g. quick login demo panel)
VITE_DEMO_MODE="true"

